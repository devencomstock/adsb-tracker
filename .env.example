# Copy to .env (never commit .env) and set a real password.

# Used by the database container (docker-compose.yml)
POSTGRES_USER=adsb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adsb

# Used by Python code (src/ingest/), standard libpq variable names.
# The tests create and drop their own throwaway databases; PGDATABASE is never touched by them.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=adsb
PGPASSWORD=change-me
PGDATABASE=adsb
